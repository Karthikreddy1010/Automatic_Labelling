# deploy/deepthink.env - deepthink (Montclair CSAM H200 JupyterHub) environment overrides
# ============================================================================================
#
# Confirmed working configuration, verified live on deepthink on 2026-09-14:
#   - Qwen3-VL-8B-Instruct checkpoint at /home/jovyan/models/Qwen3-VL-8B-Instruct
#   - backend="transformers", dtype="bfloat16", device_map="auto"
#   - accelerate==1.15.0 present (required for device_map="auto" to place the
#     model on GPU at all -- without it, or without free GPU memory, loading
#     silently degrades to CPU instead of raising an error)
#   - A real load puts ~16.7GB on cuda:0 in ~6s once the GPU actually has free
#     memory to give it.
#
# device_map is deliberately left "auto", NOT forced to "cuda:0": this
# environment's GPU is a shared/partitioned slice (confirmed ~24.58GB via
# torch.cuda.mem_get_info(), not the full physical H200's 141GB). "auto" is
# the safe choice on a memory-constrained single GPU -- it degrades
# gracefully (falls back to CPU) when memory is tight, where a hard-coded
# "cuda:0" would instead crash with a CUDA OOM. See config.yaml's existing
# qwen.transformers.device_map default (already "auto" -- no override needed
# here for that).
#
# IMPORTANT operational note (root cause of a real incident this env hit):
# a batch job that looks frozen/crawling on this box, even though nvidia-smi
# is permission-denied here so you can't check GPU state directly, is very
# likely Qwen having silently loaded onto CPU because something else (most
# often a leftover/orphaned python process from a previous run that didn't
# get killed) is holding the entire GPU memory quota. Before starting any
# batch run:
#   ps aux | grep -i python
#   python3 -c "import torch; f,t = torch.cuda.mem_get_info(); print(f'free: {f/1e9:.2f} GB / total: {t/1e9:.2f} GB')"
# Kill any stray process still resident from a prior run before starting a
# new one -- one orphan silently eating the ~24.58GB quota is enough to push
# every subsequent Qwen load onto CPU with no hard error, just a cryptic
# accelerate warning ("... does not fit any GPU's remaining memory").
#
# Usage on deepthink, from the project root, before starting the server:
#   source deploy/deepthink.env
#   cd /home/jovyan/OBB && python3 -m uvicorn backend.app:app --host 0.0.0.0 --port 8000

export QWEN_BACKEND="transformers"
export QWEN_MODEL_PATH="/home/jovyan/models/Qwen3-VL-8B-Instruct"
