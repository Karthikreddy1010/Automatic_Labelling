# deploy/hawk.env - HAWK deployment environment overrides
# ==========================================================
#
# The values below match exactly what was requested for HAWK:
#
#   verification_pipeline:
#     sam3:
#       backend: "http"
#       service_url: "http://127.0.0.1:8801"
#     qwen:
#       backend: "transformers"
#       gating: "gated"
#       transformers:
#         model_path: "/home/maska/models/Qwen3-VL-8B-Instruct"
#         dtype: "bfloat16"
#         device_map: "auto"
#
# These are NOT baked into configs/config.yaml as the checked-in defaults,
# because that file is shared across every environment this repo runs in
# (including local dev machines using Ollama with no SAM3 service at all) --
# hard-coding HAWK's paths/URLs there would silently break those. Every
# value below is read from an env var FIRST, config.yaml second (see
# backend/app.py::_build_sam3_adapter / _build_qwen_verifier), so sourcing
# this file is enough on HAWK without touching the shared config.
#
# qwen.gating ("gated"), qwen.transformers.dtype ("bfloat16"), and
# qwen.transformers.device_map ("auto") already match these values in
# configs/config.yaml's checked-in defaults -- no override needed for those.
#
# Usage on HAWK, in the PoleAnnotator/Qwen environment, before starting the
# main app:
#   source deploy/hawk.env
#   python run_backend.py
#
# (Only export SAM3_SERVICE_URL/SAM3_BACKEND here -- the SAM3 Singularity
# sandbox is a completely separate Python process/environment and does not
# source this file; it just runs services/sam3_service.py directly, see
# deploy/hawk_start_sam3_service.sh.)

export QWEN_BACKEND="transformers"
export QWEN_MODEL_PATH="/home/maska/models/Qwen3-VL-8B-Instruct"

export SAM3_BACKEND="http"
export SAM3_SERVICE_URL="http://127.0.0.1:8801"
